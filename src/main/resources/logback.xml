<?xml version="1.0" encoding="UTF-8"?>
<!--
  One JSON line per event on stdout (ts, level, msg, logger, service, env, plus
  whatever key-values a log call adds). Logs are queried by field, never by grepping prose: the text changes,
  the fields do not.
-->
<configuration>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <timestampPattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</timestampPattern>
            <fieldNames>
                <timestamp>ts</timestamp>
                <level>level</level>
                <message>msg</message>
                <logger>logger</logger>
                <thread>[ignore]</thread>
                <levelValue>[ignore]</levelValue>
                <version>[ignore]</version>
                <stackTrace>stack</stackTrace>
            </fieldNames>
            <customFields>{"service":"affiliate-app","env":"${OPERATOR:-local}"}</customFields>
            <!-- A longer stack is not diagnosis but noise that pushes the neighbouring lines out. -->
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>30</maxDepthPerThrowable>
                <maxLength>4096</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
                <exclude>^sun\.reflect\..*</exclude>
                <exclude>^java\.util\.concurrent\..*</exclude>
            </throwableConverter>
        </encoder>
    </appender>

    <!--
      Asynchronous, yet losing nothing: discardingThreshold 0 keeps WARN and ERROR when the queue is full,
      which is exactly when the app is in trouble and those lines are needed.
    -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="JSON"/>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="ASYNC"/>
    </root>

    <logger name="io.netty" level="WARN"/>
    <logger name="io.grpc" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.flywaydb" level="WARN"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.coyote" level="WARN"/>
    <logger name="org.apache.tomcat" level="WARN"/>

</configuration>
