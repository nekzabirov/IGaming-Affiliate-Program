# The local stand (docker-compose.yml). Copy to .env and load it into the shell before running the app:
#   cp .env.example .env && set -a && . ./.env && set +a
# Every variable and its meaning: README "Configuration".

SERVER_PORT=8080
METRICS_PORT=9464

DB_URL=jdbc:postgresql://localhost:55450
DATABASE_NAME=affiliate
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=5

RABBIT_HOST=localhost
RABBIT_PORT=55680
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_SSL_ENABLED=false
RABBIT_PREFETCH=32
PAM_EXCHANGE=pam.events
CASINO_EXCHANGE=casino.events
EVENT_QUEUE=affiliate.events

# Currency-Exchange-Service (https://github.com/nekzabirov/Currency-Exchange-Service): its own docker compose
# publishes gRPC in plaintext on 59090. Only facts in another currency than PARTNER_CURRENCY call it.
CURRENCY_GRPC_HOST=localhost
CURRENCY_GRPC_PORT=59090
CURRENCY_GRPC_PLAINTEXT=true

PARTNER_CURRENCY=USDT
CPA_MIN_DEPOSIT=10
PAYOUT_NETWORKS=TRC20,ERC20,BEP20,TON
SITE_URL=http://localhost:3000
SUPPORT_TELEGRAM_URL=
POSTBACK_SOURCE_IP=

# Plain http on a laptop: a browser never sends a Secure cookie back over it.
SESSION_COOKIE_SECURE=false
SESSION_TTL_DAYS=30
